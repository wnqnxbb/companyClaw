{
  "name": "companyclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal standalone code-agent runtime inspired by openclaw",
  "type": "module",
  "bin": {
    "companyclaw": "./dist/src/cli.js"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "agent": "tsx src/cli.ts agent",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.57.1",
    "@sinclair/typebox": "^0.34.41",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
