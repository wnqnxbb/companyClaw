{
  "bootstrapFiles": [
    "AGENTS.md",
    "SOUL.md",
    "USER.md",
    "IDENTITY.md",
    "TOOLS.md",
    "BOOTSTRAP.md",
    "MEMORY.md"
  ],
  "runtime": {
    "thinkingLevel": "medium",
    "timeoutMs": 600000,
    "execTimeoutMs": 120000,
    "observability": {
      "enabled": true,
      "logDir": "logs",
      "console": false,
      "includePrompts": true,
      "includeToolArgs": true,
      "includeToolResults": true,
      "includeAssistantDeltas": true,
      "includeLlmRequests": true
    }
  },
  "primaryModel": {
    "provider": "openai",
    "id": "gpt-4.1",
    "api": "openai-completions",
    "apiKeyEnv": "OPENAI_API_KEY",
    "contextWindow": 128000,
    "maxTokens": 16384,
    "reasoning": false,
    "input": ["text"]
  },
  "fallbackModels": [
    {
      "provider": "openai",
      "id": "gpt-4.1-mini",
      "api": "openai-completions",
      "apiKeyEnv": "OPENAI_API_KEY",
      "contextWindow": 128000,
      "maxTokens": 16384,
      "reasoning": false,
      "input": ["text"]
    }
  ]
}
